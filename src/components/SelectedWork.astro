---
const projects = [
  {
    title: "Cellaxys",
    category: "Healthcare website",
    href: "/work/cellaxys",
    image: "/images/work/cellaxys.png",
    theme: "cellaxys",
  },
  {
    title: "DeveloperWeek",
    category: "Developer conference platform",
    href: "/work/developerweek",
    image: null,
    theme: "developerweek",
  },
  {
    title: "Primmed",
    category: "Healthcare website",
    href: "/work/primmed",
    image: null,
    theme: "primmed",
  },
  {
    title: "API World",
    category: "Developer conference website",
    href: "/work/api-world",
    image: null,
    theme: "apiworld",
  },
];
---

<section class="work">
  <div class="container">
    <div class="work__header">
      <div>
        <p class="work__eyebrow">SELECTED WORK</p>

        <h2 class="work__title">
          A few things<br />
          we've built.
        </h2>
      </div>

      <div class="work__intro">
        <p>
          Websites and digital products built for companies across healthcare,
          technology, and events.
        </p>

        <a class="work__all" href="/work">
          View all work
          <span aria-hidden="true">→</span>
        </a>
      </div>
    </div>

    <div class="work__grid">
      {
        projects.map((project) => (
          <article class="project">
            <a
              class="project__link"
              href={project.href}
              aria-label={`View ${project.title} project`}
            >
              <div
                class={`project__visual project__visual--${project.theme}`}
              >
                {project.image ? (
                  <div class="project__screenshot">
                    <img
                      src={project.image}
                      alt={`${project.title} website`}
                      width="1920"
                      height="1080"
                      loading="lazy"
                    />
                  </div>
                ) : (
                  <div class="project__placeholder">
                    <span>{project.title}</span>
                    <small>Screenshot coming soon</small>
                  </div>
                )}
              </div>

              <div class="project__meta">
                <div>
                  <h3>{project.title}</h3>
                  <p>{project.category}</p>
                </div>

                <span class="project__arrow" aria-hidden="true">↗</span>
              </div>
            </a>
          </article>
        ))
      }
    </div>
  </div>
</section>

<style>
  /*
   * Section
   */

  .work {
    padding: 120px 0;
    border-bottom: 1px solid var(--color-border);
    background: var(--color-bg);
  }

  /*
   * Header
   */

  .work__header {
    display: grid;
    grid-template-columns: 1.2fr 1fr;
    gap: 80px;
    align-items: end;

    margin-bottom: 72px;
  }

  .work__eyebrow {
    margin: 0 0 24px;

    color: var(--color-accent);

    font-size: 13px;
    font-weight: 650;
    line-height: 1;

    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .work__title {
    margin: 0;

    color: var(--color-text);

    font-size: clamp(42px, 4.5vw, 64px);
    font-weight: 700;
    line-height: 1;

    letter-spacing: -0.05em;
  }

  .work__intro {
    max-width: 480px;
  }

  .work__intro p {
    margin: 0 0 24px;

    color: var(--color-text-secondary);

    font-size: 18px;
    line-height: 1.6;
  }

  .work__all {
    display: inline-flex;
    align-items: center;
    gap: 9px;

    color: var(--color-text);

    font-size: 15px;
    font-weight: 600;
    line-height: 1.4;
  }

  .work__all span {
    transition: transform var(--transition);
  }

  .work__all:hover span {
    transform: translateX(5px);
  }

  /*
   * Projects grid
   */

  .work__grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 64px 32px;
  }

  .project {
    min-width: 0;
  }

  .project__link {
    display: block;
  }

  /*
   * Colored project canvas
   */

  .project__visual {
    position: relative;

    display: flex;
    align-items: flex-end;
    justify-content: center;

    width: 100%;
    aspect-ratio: 16 / 11;

    overflow: hidden;

    padding: 20px 20px 0;
  }

  /*
   * Project backgrounds
   */

  .project__visual--cellaxys {
    background:
      radial-gradient(
        circle at 80% 20%,
        rgba(255, 255, 255, 0.55),
        transparent 40%
      ),
      #dce9e6;
  }

  .project__visual--developerweek {
    background:
      radial-gradient(
        circle at 20% 20%,
        rgba(255, 255, 255, 0.1),
        transparent 40%
      ),
      #25243d;
  }

  .project__visual--primmed {
    background:
      radial-gradient(
        circle at 20% 20%,
        rgba(255, 255, 255, 0.65),
        transparent 40%
      ),
      #e7ecef;
  }

  .project__visual--apiworld {
    background:
      radial-gradient(
        circle at 75% 20%,
        rgba(255, 255, 255, 0.1),
        transparent 40%
      ),
      #18273c;
  }

  /*
   * Screenshot
   */

  .project__screenshot {
    position: relative;

    width: 100%;
    aspect-ratio: 16 / 9;

    overflow: hidden;

    border-radius: 5px 5px 0 0;

    background: #ffffff;

    box-shadow:
      0 -2px 8px rgba(0, 0, 0, 0.03),
      0 18px 45px rgba(0, 0, 0, 0.12);

    transition:
      transform 450ms ease,
      box-shadow 450ms ease;
  }

  .project__screenshot img {
    position: absolute;
    inset: 0;

    display: block;

    width: 100%;
    height: 100%;

    object-fit: contain;
    object-position: center;

    background: #ffffff;
  }

  /*
   * Screenshot hover
   */

  .project__link:hover .project__screenshot {
    transform: translateY(-4px);

    box-shadow:
      0 -2px 8px rgba(0, 0, 0, 0.04),
      0 24px 55px rgba(0, 0, 0, 0.16);
  }

  /*
   * Temporary placeholders
   */

  .project__placeholder {
    width: 100%;
    aspect-ratio: 16 / 9;

    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 7px;

    border-radius: 5px 5px 0 0;

    background: rgba(255, 255, 255, 0.94);

    box-shadow:
      0 -2px 8px rgba(0, 0, 0, 0.03),
      0 18px 45px rgba(0, 0, 0, 0.1);
  }

  .project__placeholder span {
    color: var(--color-text);

    font-size: 17px;
    font-weight: 650;
    line-height: 1.3;

    letter-spacing: -0.02em;
  }

  .project__placeholder small {
    color: var(--color-text-secondary);

    font-size: 12px;
    line-height: 1.4;
  }

  /*
   * Project information
   */

  .project__meta {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 24px;

    padding-top: 20px;
  }

  .project__meta h3 {
    margin: 0 0 5px;

    color: var(--color-text);

    font-size: 20px;
    font-weight: 650;
    line-height: 1.25;

    letter-spacing: -0.025em;
  }

  .project__meta p {
    margin: 0;

    color: var(--color-text-secondary);

    font-size: 14px;
    line-height: 1.5;
  }

  .project__arrow {
    flex: 0 0 auto;

    margin-top: 2px;

    color: var(--color-text);

    font-size: 18px;
    line-height: 1;

    transition:
      color var(--transition),
      transform var(--transition);
  }

  .project__link:hover .project__arrow {
    color: var(--color-accent);
    transform: translate(3px, -3px);
  }

  /*
   * Tablet
   */

  @media (max-width: 900px) {
    .work {
      padding: 96px 0;
    }

    .work__header {
      grid-template-columns: 1fr;
      gap: 28px;

      margin-bottom: 64px;
    }

    .work__title br {
      display: none;
    }

    .work__grid {
      gap: 52px 24px;
    }

    .project__visual {
      padding: 16px 16px 0;
    }
  }

  /*
   * Mobile
   */

  @media (max-width: 680px) {
    .work {
      padding: 80px 0;
    }

    .work__header {
      margin-bottom: 48px;
    }

    .work__intro p {
      font-size: 17px;
    }

    .work__grid {
      grid-template-columns: 1fr;
      gap: 48px;
    }

    .project__visual {
      padding: 16px 16px 0;
    }

    .project__meta {
      padding-top: 18px;
    }
  }

  @media (max-width: 420px) {
    .project__visual {
      padding: 12px 12px 0;
    }
  }
</style>