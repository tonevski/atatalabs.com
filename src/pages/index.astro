---
// Shared layout and homepage sections. Edit each component to change its text or styles.
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/Header.astro";
import Hero from "../components/Hero.astro";
import Credibility from "../components/Credibility.astro";
import Services from "../components/Services.astro";
import SelectedWork from "../components/SelectedWork.astro";
import Testimonials from "../components/Testimonials.astro";
import CTA from "../components/CTA.astro";
import Footer from "../components/Footer.astro";
---

{/* Wraps the homepage in the shared site layout. */}
<BaseLayout>
  {/* Site header and primary navigation. */}
  <Header />

  <main>
    {/* Introduces Atata Labs: websites and apps for businesses, with links to contact and work. */}
    <Hero />

    {/* Explains the focus on lasting partnerships, supported by years working with clients. */}
    <Credibility />

    {/* Summarizes website development, web and mobile applications, and ongoing support. */}
    <Services />

    {/* Showcases selected projects so visitors can explore examples of the team's work. */}
    <SelectedWork />

    {/* Shares client feedback about quality, communication, and long-term reliability. */}
    <Testimonials />

    {/* Call to action: invites visitors to discuss a project through the contact page. */}
    <CTA />
  </main>

  {/* Shared site footer. */}
  <Footer />
</BaseLayout>