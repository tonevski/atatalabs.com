---
const services = [
  {
    number: "01",
    title: "Website Development",
    description:
      "Modern websites built from scratch with a focus on performance, usability, and maintainability.",
    href: "/services/website-development",
    icon: "website",
  },
  {
    number: "02",
    title: "Web Applications",
    description:
      "Custom web applications and tools designed around your business and the way it works.",
    href: "/services/web-applications",
    icon: "webapp",
  },
  {
    number: "03",
    title: "Mobile Applications",
    description:
      "Modern mobile applications for iOS and Android, built for real-world use.",
    href: "/services/mobile-applications",
    icon: "mobile",
  },
  {
    number: "04",
    title: "Ongoing Support",
    description:
      "Long-term development, maintenance, improvements, and technical support as your business evolves.",
    href: "/services/ongoing-support",
    icon: "support",
  },
];
---

<section class="services">
  <div class="container">
    <div class="services__header">
      <p class="services__eyebrow">WHAT WE DO</p>

      <div class="services__heading">
        <h2 class="services__title">
          From idea to launch.{" "}<br />
          And what comes next.
        </h2>

        <p class="services__description">
          We design, develop, and support digital products for businesses
          that want reliable technology without unnecessary complexity.
        </p>
      </div>
    </div>

    <div class="services__grid">
      {
        services.map((service) => (
          <a class="service" href={service.href}>
            <div class="service__top">
              <span class="service__number">{service.number}</span>

              <div class="service__icon">
                {service.icon === "website" && (
                  <svg
                    viewBox="0 0 32 32"
                    fill="none"
                    aria-hidden="true"
                  >
                    <rect
                      x="3.5"
                      y="5.5"
                      width="25"
                      height="21"
                      rx="2"
                    />
                    <path d="M4 11H28" />
                    <circle cx="8" cy="8.5" r="1" fill="currentColor" stroke="none" />
                    <circle cx="12" cy="8.5" r="1" fill="currentColor" stroke="none" />
                  </svg>
                )}

                {service.icon === "webapp" && (
                  <svg
                    viewBox="0 0 32 32"
                    fill="none"
                    aria-hidden="true"
                  >
                    <rect
                      x="4"
                      y="4"
                      width="24"
                      height="24"
                      rx="2"
                    />
                    <path d="M4 11H28" />
                    <path d="M11 11V28" />
                    <path d="M15 16H23" />
                    <path d="M15 21H21" />
                  </svg>
                )}

                {service.icon === "mobile" && (
                  <svg
                    viewBox="0 0 32 32"
                    fill="none"
                    aria-hidden="true"
                  >
                    <rect
                      x="9"
                      y="3"
                      width="14"
                      height="26"
                      rx="3"
                    />
                    <path d="M13 7H19" />
                    <circle
                      cx="16"
                      cy="25"
                      r="1"
                      fill="currentColor"
                      stroke="none"
                    />
                  </svg>
                )}

                {service.icon === "support" && (
                  <svg
                    viewBox="0 0 32 32"
                    fill="none"
                    aria-hidden="true"
                  >
                    <path d="M16 5A11 11 0 1 0 27 16" />
                    <path d="M22 5H27V10" />
                    <path d="M27 5L21 11" />
                    <path d="M11 16L14 19L21 12" />
                  </svg>
                )}
              </div>
            </div>

            <div class="service__content">
              <h3>{service.title}</h3>

              <p>{service.description}</p>
            </div>

            <div class="service__footer">
              <span>Learn more</span>
              <span class="service__arrow" aria-hidden="true">→</span>
            </div>
          </a>
        ))
      }
    </div>
  </div>
</section>

<style>
  .services {
    padding: 120px 0;
    border-bottom: 1px solid var(--color-border);
    background: var(--color-bg-subtle);
  }

  /*
   * Header
   */

  .services__header {
    margin-bottom: 72px;
  }

  .services__eyebrow {
    margin: 0 0 24px;

    color: var(--color-accent);

    font-size: 13px;
    font-weight: 650;
    line-height: 1;

    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .services__heading {
    display: grid;
    grid-template-columns: 1.2fr 1fr;
    gap: 80px;
    align-items: end;
  }

  .services__title {
    margin: 0;

    font-size: clamp(42px, 4.5vw, 64px);
    font-weight: 700;
    line-height: 1;

    letter-spacing: -0.05em;
  }

  .services__description {
    max-width: 480px;
    margin: 0;

    color: var(--color-text-secondary);

    font-size: 18px;
    line-height: 1.6;
  }

  /*
   * Grid
   */

  .services__grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);

    border-top: 1px solid var(--color-border);
    border-left: 1px solid var(--color-border);
  }

  /*
   * Service card
   */

  .service {
    position: relative;

    min-height: 390px;

    display: flex;
    flex-direction: column;

    padding: 36px;

    border-right: 1px solid var(--color-border);
    border-bottom: 1px solid var(--color-border);

    background: var(--color-bg);

    transition:
      background var(--transition),
      transform var(--transition);
  }

  .service:hover {
    background: #fff;
  }

  /*
   * Card top
   */

  .service__top {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;

    margin-bottom: 64px;
  }

  .service__number {
    color: var(--color-text-secondary);

    font-size: 12px;
    font-weight: 600;
    line-height: 1;

    letter-spacing: 0.08em;
  }

  .service__icon {
    width: 48px;
    height: 48px;

    display: flex;
    align-items: center;
    justify-content: center;

    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);

    color: var(--color-text);

    transition:
      color var(--transition),
      border-color var(--transition),
      background var(--transition);
  }

  .service__icon svg {
    width: 24px;
    height: 24px;

    stroke: currentColor;
    stroke-width: 1.4;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .service:hover .service__icon {
    border-color: rgba(255, 16, 83, 0.2);
    background: rgba(255, 16, 83, 0.05);
    color: var(--color-accent);
  }

  /*
   * Card content
   */

  .service__content {
    max-width: 440px;
  }

  .service__content h3 {
    margin: 0 0 16px;

    font-size: 27px;
    font-weight: 650;
    line-height: 1.1;

    letter-spacing: -0.035em;
  }

  .service__content p {
    margin: 0;

    color: var(--color-text-secondary);

    font-size: 16px;
    line-height: 1.65;
  }

  /*
   * Card footer
   */

  .service__footer {
    display: flex;
    align-items: center;
    gap: 8px;

    margin-top: auto;
    padding-top: 40px;

    font-size: 14px;
    font-weight: 600;
  }

  .service__arrow {
    transition: transform var(--transition);
  }

  .service:hover .service__arrow {
    transform: translateX(5px);
  }

  /*
   * Tablet
   */

  @media (max-width: 900px) {
    .services {
      padding: 96px 0;
    }

    .services__heading {
      grid-template-columns: 1fr;
      gap: 28px;
    }

    .services__title br {
      display: none;
    }

    .services__grid {
      grid-template-columns: 1fr;
    }

    .service {
      min-height: 340px;
    }
  }

  /*
   * Mobile
   */

  @media (max-width: 520px) {
    .services {
      padding: 80px 0;
    }

    .services__header {
      margin-bottom: 48px;
    }

    .services__description {
      font-size: 17px;
    }

    .service {
      min-height: 320px;
      padding: 28px;
    }

    .service__top {
      margin-bottom: 48px;
    }

    .service__content h3 {
      font-size: 24px;
    }
  }
</style>
