---
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/Header.astro";
import CTA from "../components/CTA.astro";
import Footer from "../components/Footer.astro";
---

<BaseLayout
  title="About — Atata Labs"
  description="Atata Labs is an independent development studio building websites and applications for long-term clients."
>
  <Header />

  <main>
    <section class="page-hero">
      <div class="container">
        <p class="eyebrow">ABOUT ATATA LABS</p>

        <h1>
          Built for long-term{" "}<br />
          partnerships.
        </h1>
      </div>
    </section>

    <section class="about">
      <div class="container about__grid">
        <div>
          <p class="about__lead">
            Atata Labs is a development studio led by Nikola Tonevski.
          </p>
        </div>

        <div class="about__content">
          <p>
            We build modern websites, web applications, and mobile applications
            for companies that value quality, reliability, and straightforward
            communication.
          </p>

          <p>
            With more than a decade of development experience, our approach is
            simple: understand the business, build what it needs, and stay
            around to support it.
          </p>

          <p>
            Some of our client relationships have lasted more than eight and
            ten years. We prefer long-term partnerships over one-off projects.
          </p>
        </div>
      </div>
    </section>

    <section class="stats">
      <div class="container stats__grid">
        <div>
          <strong>10+</strong>
          <span>Years of experience</span>
        </div>

        <div>
          <strong>10+ years</strong>
          <span>Longest client relationship</span>
        </div>

        <div>
          <strong>8+ years</strong>
          <span>Another ongoing partnership</span>
        </div>
      </div>
    </section>

    <CTA />
  </main>

  <Footer />
</BaseLayout>

<style>
  .page-hero {
    padding: 120px 0;
    border-bottom: 1px solid var(--color-border);
  }

  .eyebrow {
    margin: 0 0 28px;
    color: var(--color-accent);
    font-size: 13px;
    font-weight: 650;
    letter-spacing: 0.08em;
  }

  h1 {
    max-width: 950px;
    margin: 0;
    font-size: clamp(54px, 7vw, 96px);
    font-weight: 700;
    line-height: 0.95;
    letter-spacing: -0.06em;
  }

  .about {
    padding: 120px 0;
  }

  .about__grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 100px;
  }

  .about__lead {
    max-width: 500px;
    margin: 0;
    font-size: clamp(30px, 3vw, 44px);
    font-weight: 650;
    line-height: 1.15;
    letter-spacing: -0.04em;
  }

  .about__content {
    max-width: 570px;
  }

  .about__content p {
    margin: 0 0 28px;
    color: var(--color-text-secondary);
    font-size: 18px;
    line-height: 1.7;
  }

  .stats {
    padding: 0 0 120px;
  }

  .stats__grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    border-top: 1px solid var(--color-border);
    border-bottom: 1px solid var(--color-border);
  }

  .stats__grid > div {
    padding: 48px 32px;
    border-right: 1px solid var(--color-border);
  }

  .stats__grid > div:first-child {
    padding-left: 0;
  }

  .stats__grid > div:last-child {
    border-right: 0;
  }

  .stats strong,
  .stats span {
    display: block;
  }

  .stats strong {
    margin-bottom: 8px;
    font-size: 32px;
    letter-spacing: -0.04em;
  }

  .stats span {
    color: var(--color-text-secondary);
    font-size: 14px;
  }

  @media (max-width: 680px) {
    .page-hero,
    .about {
      padding: 80px 0;
    }

    .about__grid {
      grid-template-columns: 1fr;
      gap: 48px;
    }

    .stats {
      padding-bottom: 80px;
    }

    .stats__grid {
      grid-template-columns: 1fr;
    }

    .stats__grid > div,
    .stats__grid > div:first-child {
      padding: 32px 0;
      border-right: 0;
      border-bottom: 1px solid var(--color-border);
    }

    .stats__grid > div:last-child {
      border-bottom: 0;
    }
  }
</style>
