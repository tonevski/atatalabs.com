---
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/Header.astro";
import Testimonials from "../components/Testimonials.astro";
import CTA from "../components/CTA.astro";
import Footer from "../components/Footer.astro";
---

<BaseLayout
  title="Testimonials — Atata Labs"
  description="Read what clients say about working with Atata Labs on websites, applications, and ongoing development support."
>
  <Header />

  <main>
    <section class="page-hero">
      <div class="container">
        <p class="eyebrow">TESTIMONIALS</p>
        <h1>In our clients’ words.</h1>
      </div>
    </section>

    {/* Reuses the client quotes shown on the homepage. */}
    <Testimonials />

    {/* Invites visitors to get in touch about their own project. */}
    <CTA />
  </main>

  <Footer />
</BaseLayout>

<style>
  .page-hero {
    padding: 120px 0;
    border-bottom: 1px solid var(--color-border);
  }

  .eyebrow {
    margin: 0 0 28px;
    color: var(--color-accent);
    font-size: 13px;
    font-weight: 650;
    letter-spacing: 0.08em;
  }

  h1 {
    max-width: 950px;
    margin: 0;
    font-size: clamp(54px, 7vw, 96px);
    font-weight: 700;
    line-height: 0.95;
    letter-spacing: -0.06em;
  }

  @media (max-width: 680px) {
    .page-hero {
      padding: 80px 0;
    }
  }
</style>
